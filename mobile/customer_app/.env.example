##############################################################################
# ZIPPYRA — CUSTOMER APP (Flutter) ENVIRONMENT VARIABLES
# mobile/customer_app/.env.example — loaded via flutter_dotenv, or passed as
# --dart-define-from-file for build-time injection (recommended for secrets
# that must not ship inside the compiled asset bundle, like API keys tied
# to release signing).
##############################################################################

# ─────────────────────────────────────────────────────────────────────────
# 1. APP / ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────
APP_ENV=development                      # development | staging | production
APP_VERSION_NAME=1.0.0
APP_MIN_SUPPORTED_VERSION=1.0.0          # backend also enforces via /v1/auth/version-check

# ─────────────────────────────────────────────────────────────────────────
# 2. API ENDPOINTS
# ─────────────────────────────────────────────────────────────────────────
API_BASE_URL_DEV=http://10.0.2.2:8080        # Android emulator loopback to localhost
API_BASE_URL_STAGING=https://staging-api.zippyra.com
API_BASE_URL_PROD=https://api.zippyra.com
WS_BASE_URL_PROD=wss://api.zippyra.com/ws

# TLS certificate pinning (Gap #14) — SHA-256 of the leaf/backup cert
CERT_PIN_SHA256_PRIMARY=
CERT_PIN_SHA256_BACKUP=

# ─────────────────────────────────────────────────────────────────────────
# 3. AUTH — Phone OTP / Email OTP / Google OAuth
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_OAUTH_SERVER_CLIENT_ID=           # "server client ID" — must match backend GOOGLE_OAUTH_CLIENT_ID_WEB
GOOGLE_OAUTH_IOS_CLIENT_ID=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=          # not passed directly to google_sign_in, but recorded for reference

# ─────────────────────────────────────────────────────────────────────────
# 4. PAYMENTS
# ─────────────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=                         # public key only

# ─────────────────────────────────────────────────────────────────────────
# 5. MAPS / GEOFENCE (store discovery + entrance detection)
# ─────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# ─────────────────────────────────────────────────────────────────────────
# 6. PUSH NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────
# Firebase config is NOT set via env — it ships as google-services.json
# (Android, in android/app/) and GoogleService-Info.plist (iOS, in ios/Runner/).
FCM_VAPID_KEY=                           # only needed if Flutter Web push is supported

# ─────────────────────────────────────────────────────────────────────────
# 7. DEVICE ATTESTATION / SECURITY
# ─────────────────────────────────────────────────────────────────────────
PLAY_INTEGRITY_CLOUD_PROJECT_NUMBER=     # Gap #15 — Android device attestation
ROOT_JAILBREAK_CHECK_ENABLED=true        # Gap #29

# ─────────────────────────────────────────────────────────────────────────
# 8. OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────
SENTRY_DSN_MOBILE=
SENTRY_TRACES_SAMPLE_RATE=0.2

# ─────────────────────────────────────────────────────────────────────────
# 9. FEATURE FLAGS / MISC
# ─────────────────────────────────────────────────────────────────────────
DEFAULT_LOCALE=en                        # en | hi
OFFLINE_SYNC_JITTER_MAX_SECONDS=30
OFFER_CACHE_MAX_AGE_SECONDS=300
