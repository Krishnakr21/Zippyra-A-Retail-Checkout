##############################################################################
# ZIPPYRA — WEB ENVIRONMENT VARIABLES
# One shared template for all 3 Next.js apps: web/apps/{retailer,admin,hq}.
# Copy to web/apps/<app>/.env.local — values differing per app are marked.
##############################################################################

# ─────────────────────────────────────────────────────────────────────────
# 1. APP IDENTITY (differs per app)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=retailer                # retailer | admin | hq
NEXT_PUBLIC_ENV=development                  # development | staging | production

# ─────────────────────────────────────────────────────────────────────────
# 2. API / BACKEND
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws     # device heartbeat / low-stock live updates
API_INTERNAL_BASE_URL=http://localhost:8080   # used by Next.js API routes (BFF), server-side only

# ─────────────────────────────────────────────────────────────────────────
# 3. AUTH (NextAuth — staff/admin/chain-hq SSO)
# ─────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=changeme-generate-a-long-random-string
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=           # only if staff/admin also support "Continue with Google"
ADMIN_2FA_ISSUER=Zippyra                      # Google Authenticator TOTP issuer label

# ─────────────────────────────────────────────────────────────────────────
# 4. PAYMENTS (public key only — never expose secret key to the browser)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─────────────────────────────────────────────────────────────────────────
# 5. MAPS (Step 2 of onboarding wizard — geofence polygon drawing; admin app only)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# 6. ANALYTICS (retailer + hq apps — ClickHouse-backed dashboards via BFF)
# ─────────────────────────────────────────────────────────────────────────
CLICKHOUSE_READ_HOST=localhost
CLICKHOUSE_READ_PORT=8123
CLICKHOUSE_READ_USER=readonly
CLICKHOUSE_READ_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# 7. OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=                            # for sourcemap upload during build only

# ─────────────────────────────────────────────────────────────────────────
# 8. SECURITY (CSP / headers — set in next.config.ts, referenced here for env-based origins)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CSP_CONNECT_SRC=https://api.zippyra.com
ALLOWED_ADMIN_EMAIL_DOMAIN=zippyra.com        # admin app only — restricts SSO signup domain

# ─────────────────────────────────────────────────────────────────────────
# 9. ERP INTEGRATIONS (hq app only — SAP/Tally/Busy config screens)
# ─────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ERP_INTEGRATION_DOCS_URL=https://docs.zippyra.com/erp
