##############################################################################
# ZIPPYRA — BACKEND ENVIRONMENT VARIABLES (backend/.env.example)
# Shared by all 21 Go microservices (each reads only the vars it needs).
# Copy to backend/.env for local dev. In staging/production these are injected
# via AWS Secrets Manager + Kubernetes Secrets — NEVER commit a real .env.
##############################################################################

# ─────────────────────────────────────────────────────────────────────────
# 1. CORE / ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                 # development | staging | production
APP_VERSION=1.0.0
LOG_LEVEL=info                          # debug | info | warn | error
AWS_REGION=ap-south-1                   # MUST stay ap-south-1 / ap-south-2 (DPDP data localization)
REQUEST_ID_HEADER=X-Request-ID

# Per-service port reference (each service reads its own PORT var; defaults shown)
AUTH_SERVICE_PORT=8080
STORE_SERVICE_PORT=8082
CATALOG_SERVICE_PORT=8083
CART_SERVICE_PORT=8084
PAYMENT_SERVICE_PORT=8085
ORDER_SERVICE_PORT=8086
EXIT_VALIDATION_SERVICE_PORT=8087
NOTIFICATION_SERVICE_PORT=8088
LOYALTY_SERVICE_PORT=8089
INVENTORY_SERVICE_PORT=8090
WAREHOUSE_SERVICE_PORT=8091
ANALYTICS_SERVICE_PORT=8092
SUPPORT_SERVICE_PORT=8093
RETAILER_AUTH_SERVICE_PORT=8094
ADMIN_AUTH_SERVICE_PORT=8095
CHAIN_HQ_SERVICE_PORT=8096
ADMIN_STORE_SERVICE_PORT=8097
COMPLIANCE_SERVICE_PORT=8098
QC_SERVICE_PORT=8099
TRANSFER_SERVICE_PORT=8100
AUDIT_SERVICE_PORT=8101
DEVICE_MGMT_SERVICE_PORT=8102
INTEGRATION_SERVICE_PORT=8103

# ─────────────────────────────────────────────────────────────────────────
# 2. POSTGRESQL (primary datastore — via RDS Proxy in staging/prod)
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://zippyra:changeme@localhost:5432/zippyra?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zippyra
DB_USER=zippyra
DB_PASSWORD=changeme
DB_SSL_MODE=disable                     # require in staging/production
DB_MAX_CONNS=10                         # keep low — RDS Proxy handles multiplexing
DB_MIN_CONNS=2
DB_CONN_TIMEOUT_SECONDS=5
DB_QUERY_TIMEOUT_SECONDS=5
RDS_PROXY_ENDPOINT=                     # set in staging/prod: zippyra-rds-proxy.proxy-xxxx.ap-south-1.rds.amazonaws.com
RDS_IAM_AUTH_ENABLED=false              # true in production (Gap #67 — no static passwords)

# ─────────────────────────────────────────────────────────────────────────
# 3. REDIS — 6 logical clusters, each with its own eviction policy
# ─────────────────────────────────────────────────────────────────────────
REDIS_CART_HOST=localhost
REDIS_CART_PORT=6379
REDIS_CART_PASSWORD=
REDIS_SESSION_HOST=localhost            # JWT blacklist, refresh session cache
REDIS_SESSION_PORT=6379
REDIS_SESSION_PASSWORD=
REDIS_SKU_CACHE_HOST=localhost          # catalog/barcode cache, allkeys-lru
REDIS_SKU_CACHE_PORT=6379
REDIS_SKU_CACHE_PASSWORD=
REDIS_RATE_LIMIT_HOST=localhost         # OTP + API rate limiting counters
REDIS_RATE_LIMIT_PORT=6379
REDIS_RATE_LIMIT_PASSWORD=
REDIS_EXIT_TOKEN_HOST=localhost         # noeviction — exit QR tokens, never evict
REDIS_EXIT_TOKEN_PORT=6379
REDIS_EXIT_TOKEN_PASSWORD=
REDIS_REALTIME_HOST=localhost           # store capacity, device heartbeats, pub/sub
REDIS_REALTIME_PORT=6379
REDIS_REALTIME_PASSWORD=
REDIS_CONN_TIMEOUT_MS=100

# ─────────────────────────────────────────────────────────────────────────
# 4. KAFKA / AWS MSK
# ─────────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT       # SASL_SSL in staging/prod
KAFKA_SASL_MECHANISM=                   # AWS_MSK_IAM in production
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CONSUMER_GROUP_PREFIX=zippyra-dev
KAFKA_SCHEMA_REGISTRY_URL=              # AWS Glue Schema Registry endpoint (Gap #77)
KAFKA_TOPIC_PARTITIONS_DEFAULT=6
KAFKA_TOPIC_PARTITIONS_CART_SCAN=256    # cart.item_scanned — high throughput topic

# ─────────────────────────────────────────────────────────────────────────
# 5. ELASTICSEARCH / OPENSEARCH (catalog search)
# ─────────────────────────────────────────────────────────────────────────
ES_HOST=localhost
ES_PORT=9200
ES_USERNAME=
ES_PASSWORD=
ES_USE_TLS=false
ES_INDEX_PREFIX=zippyra_dev
ES_QUERY_TIMEOUT_MS=800                 # fallback to Postgres ILIKE beyond this (Gap #80)

# ─────────────────────────────────────────────────────────────────────────
# 6. CLICKHOUSE (analytics-service)
# ─────────────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=zippyra_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────
# 7. TIMESCALEDB (inventory movements, IoT device telemetry)
# ─────────────────────────────────────────────────────────────────────────
TIMESCALE_URL=postgres://zippyra:changeme@localhost:5433/zippyra_timeseries?sslmode=disable

# ─────────────────────────────────────────────────────────────────────────
# 8. JWT / SESSIONS (shared/jwt) — Ed25519, kid-based rotation
# ─────────────────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_CURRENT=                # base64 Ed25519 private key, current signing key
JWT_PUBLIC_KEY_CURRENT=                 # base64 Ed25519 public key
JWT_KID_CURRENT=key-2026-07-a
JWT_PRIVATE_KEY_PREVIOUS=               # kept 24h during rotation window
JWT_PUBLIC_KEY_PREVIOUS=
JWT_KID_PREVIOUS=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_EXIT_TOKEN_TTL_MINUTES=10
JWT_ISSUER=zippyra.com
JWT_KEY_ROTATION_DAYS=90

# ─────────────────────────────────────────────────────────────────────────
# 9. OTP AUTH (Phone + Email)
# ─────────────────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_WRONG_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_RATE_LIMIT_PER_IDENTIFIER_PER_15MIN=5
OTP_RATE_LIMIT_PER_IP_PER_15MIN=10

# --- SMS provider (Phone OTP) ---
SMS_PROVIDER=twilio                     # twilio | msg91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=ZPYRA

# --- Email OTP via Gmail SMTP ---
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USER=                        # e.g. otp@yourcompany.com (Gmail/Workspace account)
GMAIL_SMTP_APP_PASSWORD=                # 16-char Google App Password (requires 2FA on the account)
EMAIL_FROM_NAME=Zippyra
# NOTE: personal Gmail SMTP is rate-limited (~500 msgs/day) — pilot/dev only.
# Migrate to AWS SES or Google Workspace SMTP relay before scaling.

# --- Google OAuth ("Continue with Google") ---
GOOGLE_OAUTH_CLIENT_ID_WEB=             # used as audience to verify id_token server-side
GOOGLE_OAUTH_CLIENT_ID_ANDROID=
GOOGLE_OAUTH_CLIENT_ID_IOS=
GOOGLE_OAUTH_CLIENT_SECRET=             # only if backend also does server-side OAuth code exchange

# ─────────────────────────────────────────────────────────────────────────
# 10. PAYMENTS
# ─────────────────────────────────────────────────────────────────────────
PAYMENT_PRIMARY_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_IP_ALLOWLIST=          # comma-separated CIDRs published by Razorpay
CASHFREE_APP_ID=                        # fallback gateway (circuit breaker target)
CASHFREE_SECRET_KEY=
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYMENT_OUTBOUND_TIMEOUT_SECONDS=10
PAYMENT_CIRCUIT_BREAKER_ERROR_THRESHOLD=0.05

# ─────────────────────────────────────────────────────────────────────────
# 11. NOTIFICATIONS
# ─────────────────────────────────────────────────────────────────────────
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_PAYMENT_RECEIPT=payment_receipt
WHATSAPP_TEMPLATE_EXIT_QR=exit_qr_code
WHATSAPP_TEMPLATE_LOYALTY_EARNED=loyalty_points_earned
WHATSAPP_TEMPLATE_ORDER_CONFIRMATION=order_confirmation

FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=/secrets/firebase-service-account.json

# ─────────────────────────────────────────────────────────────────────────
# 12. AWS INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=                      # prefer IRSA/instance roles in EKS — local dev only
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_INVOICES=zippyra-invoices-dev
AWS_S3_BUCKET_PRODUCTS=zippyra-products-dev
AWS_S3_BUCKET_MEDIA=zippyra-media-dev
AWS_SECRETS_MANAGER_PREFIX=zippyra/dev/
AWS_SECRETS_ROTATION_POLL_MINUTES=5

CLOUDFRONT_DOMAIN=                      # cdn.zippyra.com
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=/secrets/cloudfront-private-key.pem

# --- AWS IoT Core (gate devices / RFID / MQTT) ---
AWS_IOT_ENDPOINT=
AWS_IOT_CERT_PATH=/secrets/iot-device-cert.pem
AWS_IOT_KEY_PATH=/secrets/iot-device-key.pem
AWS_IOT_CA_PATH=/secrets/iot-root-ca.pem
MQTT_TOPIC_PREFIX=zippyra

# ─────────────────────────────────────────────────────────────────────────
# 13. INDIA COMPLIANCE (GST / DPDP / RBI)
# ─────────────────────────────────────────────────────────────────────────
GST_IRP_BASE_URL=https://einvoice1.gst.gov.in/eicore/v1.03
GST_IRP_GSP_USERNAME=
GST_IRP_GSP_PASSWORD=
GST_IRP_CLIENT_ID=
GST_IRP_CLIENT_SECRET=
GSTN_TAXPAYER_API_KEY=                  # real-time GSTIN verification on onboarding
DPDP_GRIEVANCE_OFFICER_EMAIL=grievance@zippyra.com
DPDP_DATA_RETENTION_DAYS=730

# ─────────────────────────────────────────────────────────────────────────
# 14. SECURITY
# ─────────────────────────────────────────────────────────────────────────
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
MAX_REQUEST_BODY_BYTES=1048576          # 1MB
GOOGLE_PLAY_INTEGRITY_PACKAGE_NAME=com.zippyra.customer
GOOGLE_PLAY_INTEGRITY_DECODE_URL=https://playintegrity.googleapis.com/v1
WAF_ENABLED=false                       # true in staging/prod (Terraform-managed)

# ─────────────────────────────────────────────────────────────────────────
# 15. OBSERVABILITY
# ─────────────────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME_PREFIX=zippyra
JAEGER_ENDPOINT=http://localhost:14268/api/traces
PROMETHEUS_PUSHGATEWAY=
SENTRY_DSN_BACKEND=
PAGERDUTY_INTEGRATION_KEY=
STATUS_PAGE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# 16. FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────
FEATURE_FLAGS_REDIS_PREFIX=feature:
FEATURE_FLAGS_CACHE_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────
# 17. ERP INTEGRATIONS (chain-hq-service / integration-service)
# ─────────────────────────────────────────────────────────────────────────
ERP_WEBHOOK_SHARED_SECRET=
SAP_API_BASE_URL=
TALLY_API_BASE_URL=
