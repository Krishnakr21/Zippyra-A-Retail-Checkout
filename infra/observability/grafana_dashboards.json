{
  "dashboards": [
    {
      "title": "Pilot Store Health",
      "panels": [
        {
          "title": "Cart Scan P99 Latency (SLO <= 100ms)",
          "type": "graph",
          "targets": [{ "expr": "job:cart_scan_latency_p99:ms" }]
        },
        {
          "title": "Barcode Lookup P99 Latency (SLO <= 50ms)",
          "type": "graph",
          "targets": [{ "expr": "job:barcode_lookup_latency_p99:ms" }]
        },
        {
          "title": "Exit Validation P99 Latency (SLO <= 500ms)",
          "type": "graph",
          "targets": [{ "expr": "job:exit_validation_latency_p99:ms" }]
        },
        {
          "title": "Offline Devices Count",
          "type": "stat",
          "targets": [{ "expr": "device_mgmt_offline_count" }]
        }
      ]
    },
    {
      "title": "Payment Gateway Health",
      "panels": [
        {
          "title": "Payment Success Rate (SLO >= 99.95%)",
          "type": "singlestat",
          "targets": [{ "expr": "job:payment_success_rate:ratio_rate5m * 100" }]
        },
        {
          "title": "Payment Errors by Mode",
          "type": "graph",
          "targets": [{ "expr": "sum(rate(payment_transactions_total{status='FAILED'}[5m])) by (mode)" }]
        }
      ]
    },
    {
      "title": "Core Flow Funnel",
      "panels": [
        {
          "title": "Funnel Steps Rate (AUTH -> BIND -> CATALOG -> SCAN -> CHECKOUT -> PAYMENT -> ORDER -> EXIT)",
          "type": "graph",
          "targets": [{ "expr": "sum(rate(zippyra_flow_step_total[5m])) by (step)" }]
        }
      ]
    },
    {
      "title": "Gateway Health (Kong Edge)",
      "panels": [
        {
          "title": "Kong Request Rate by Route",
          "type": "graph",
          "targets": [{ "expr": "sum(rate(kong_http_status[5m])) by (route)" }]
        },
        {
          "title": "Kong P99 Latency by Route (ms)",
          "type": "graph",
          "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(kong_latency_bucket{type='request'}[5m])) by (le, route))" }]
        },
        {
          "title": "Kong Rate Limit Rejections (429)",
          "type": "graph",
          "targets": [{ "expr": "sum(rate(kong_http_status{code='429'}[5m])) by (route)" }]
        }
      ]
    }
  ]
}
